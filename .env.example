# Copy to .env and adjust.

# Domain Traefik routes to the site (local default: localhost)
SITE_DOMAIN=localhost

# Host port for HTTP in local mode (production overlay always binds 80/443)
HTTP_PORT=80

# Let's Encrypt contact — required only with compose.prod.yaml
ACME_EMAIL=surethan37@gmail.com

# Gmail App Password for contact-form email delivery via smtp.gmail.com.
# Generate at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Paste the 16 characters WITHOUT spaces. Sender/recipient is surethan37@gmail.com
# (configured in app/config.php). Leave blank to fall back to log-only delivery.
SMTP_PASS=
