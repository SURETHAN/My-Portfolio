# ------------------------------------------------------------------
# Surethan S portfolio — Apache hardening (docroot = public/)
# Header security for the HTML page itself is sent by PHP; these rules
# cover static assets and general server hygiene.
# ------------------------------------------------------------------

Options -Indexes -MultiViews
ServerSignature Off

# Block dotfiles and backup/source leftovers
<FilesMatch "^\.|\.(bak|swp|save|orig|dist|log|sh|sql)$">
  Require all denied
</FilesMatch>

# Static assets: long cache (URLs are ?v= cache-busted)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2|webp|png|svg|jpg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

# Correct MIME for woff2 on older Apache
AddType font/woff2 .woff2
AddType image/webp .webp

# Front controller not needed (single page); stray paths 301 home so
# search engines see exactly one canonical URL instead of duplicates
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Private customer-feedback form (clean URL)
  RewriteRule ^customer-feedback/?$ /customer-feedback.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ / [R=301,L]
</IfModule>
